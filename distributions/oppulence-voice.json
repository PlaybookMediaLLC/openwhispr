{
  "schemaVersion": 1,
  "id": "oppulence-voice",
  "productName": "Oppulence Voice",
  "companyName": "Oppulence Engineering",
  "appId": "engineering.oppulence.voice",
  "protocolScheme": "oppulence-voice",
  "executableName": "oppulence-voice",
  "runtimeNamespace": "oppulence-voice",
  "windowsSafeCacheDirectory": "OppulenceVoice",
  "supportEmail": "support@oppulence.com",
