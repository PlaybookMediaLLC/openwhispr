  },
  "linux": {
    "desktopName": "oppulence-voice.desktop",
    "appName": "oppulence-voice",
    "dbusServiceName": "engineering.oppulence.Voice.Shortcuts",
    "dbusObjectPath": "/engineering/oppulence/Voice/Shortcuts",
    "dbusInterface": "engineering.oppulence.Voice.Shortcuts"
  },
  "assets": {
    "macIcon": "src/assets/icon.icns",
    "windowsIcon": "src/assets/icon.ico",
    "linuxIcon": "src/assets/icon.png"
  },
  "signing": {
    "windowsAzure": null
  },
  "capabilities": {
    "managedCloud": true,
    "rowboatExport": true
  },
  "extensions": ["rowboat-export"]
}
