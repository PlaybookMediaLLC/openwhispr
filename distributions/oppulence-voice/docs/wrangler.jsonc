{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oppulence-voice-docs",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "docs.oppulence.io",
      "custom_domain": true
    }
  ]
}
